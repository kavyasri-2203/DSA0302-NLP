# Simple word-based coverage test
known_words = set()
for category, productions in extended_grammar.items():
    for production in productions:
        for word in production.split():
            if word not in extended_grammar:
                known_words.add(word)
def analyse_message(message):
    words = message.lower().replace(",", "").replace("?", "").split()
    unknown = []
    for word in words:
        if word not in known_words:
            unknown.append(word)
    return unknown
