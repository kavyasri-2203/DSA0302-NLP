print("\nMESSAGE ANALYSIS")
print("-" * 60)
for i, message in enumerate(messages, 1):
    unknown = analyse_message(message)
    print("\nMessage", i, ":", message)
    if unknown:
        print("Unknown words:", unknown)
        print("Result: Requires fallback processing")
    else:
