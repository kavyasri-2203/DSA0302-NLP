print("\nEXAMPLE CODE-MIXED SENTENCE")
sentence = "Chennai to Madurai bus timing enna"
words = sentence.split()
for word in words:
    lower = word.lower()
    if lower in old_vocabulary:
        tag = "KNOWN"
    elif word.istitle():
        tag = "PROPER_NOUN"
    else:
        tag = "CODE_MIXED_OR_UNKNOWN"
    print(word, "->", tag)
