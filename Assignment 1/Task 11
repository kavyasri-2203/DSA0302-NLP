language_models = {
    "Unigram": {
        "perplexity": 18.4,
        "speed": "Very fast",
        "limitation": "Does not use word context"
    },
    "Bigram": {
        "perplexity": 11.7,
        "speed": "Fast",
        "limitation": "Uses only one previous word"
    },
    "Trigram": {
        "perplexity": 8.9,
        "speed": "Medium",
        "limitation": "Can suffer from data sparsity"
    },
    "Backoff": {
        "perplexity": 9.4,
        "speed": "Medium",
        "limitation": "Needs discounting and normalization"
    }
}
taggers = {
    "Rule-based": {
        "accuracy": 88,
        "speed": "Fast",
        "limitation": "Requires manual rules"
    },
    "HMM": {
        "accuracy": 91,
        "speed": "Medium",
        "limitation": "Unknown words are difficult"
    },
    "Brill": {
        "accuracy": 92,
        "speed": "Medium",
        "limitation": "Requires annotated training data"
    }
}
print("LANGUAGE MODEL COMPARISON")
print("-------------------------")
for name, details in language_models.items():
    print("\nModel:", name)
    print("Perplexity:", details["perplexity"])
    print("Speed:", details["speed"])
    print("Limitation:", details["limitation"])

print("\nPOS TAGGER COMPARISON")
print("--------------------")
for name, details in taggers.items():
    print("\nTagger:", name)
    print("Accuracy:", details["accuracy"], "%")
    print("Speed:", details["speed"])
    print("Limitation:", details["limitation"])
best_model = min(
    language_models,
    key=lambda name: language_models[name]["perplexity"]
)
best_tagger = max(
    taggers,
    key=lambda name: taggers[name]["accuracy"]
)
print("\nRECOMMENDATION")
print("--------------")
print("Best language model:", best_model)
print("Best POS tagger:", best_tagger)
