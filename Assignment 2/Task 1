print("CONTEXT FREE GRAMMAR")
print("=" * 45)
for lhs, productions in grammar.items():
    print(lhs, "->", " | ".join(productions))
print("\nNumber of non-terminals:", len(grammar))
rules = sum(len(v) for v in grammar.values())
print("Number of production alternatives:", rules)
