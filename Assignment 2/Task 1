grammar = {
    "S": ["NP VP", "IMP", "YESNO", "WH"],
    "NP": ["Det N", "Pronoun", "NP PP", "NP AdjP"],
    "VP": ["V", "V NP", "V NP PP", "V PP", "Aux VP"],
    "PP": ["P NP"],
    "AdjP": ["Adj", "Adj AdjP"],
    "CoordNP": ["NP Conj NP"],
    "CoordVP": ["VP Conj VP"],
    "IMP": ["V NP"],
    "YESNO": ["Aux NP VP"],
    "WH": ["Wh Aux NP VP"],
    "Det": ["the", "a", "an", "this", "that"],
    "N": ["student", "teacher", "exam", "fee", "hostel",
          "room", "library", "book", "timetable", "receipt",
          "notice", "course", "class", "placement", "result",
          "scholarship", "department", "office", "form", "portal"],
    "V": ["submit", "check", "show", "book", "pay", "send",
          "tell", "apply", "need", "find", "print", "cancel"],
