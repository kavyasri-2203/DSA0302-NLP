grammar = {
    "S": [["NP", "VP"]],
    "NP": [
        ["Det", "N"],
        ["Det", "N", "PP"],
        ["Pronoun"]
    ],
    "VP": [
        ["V"],
        ["V", "NP"],
        ["V", "NP", "PP"],
        ["V", "PP"]
    ],
    "PP": [["P", "NP"]],
    "Det": [["the"], ["a"]],
    "N": [
        ["student"], ["students"], ["teacher"],
        ["form"], ["fee"], ["room"], ["library"],
        ["exam"], ["hostel"], ["receipt"], ["notice"]
    ],
    "V": [
        ["submit"], ["submits"], ["check"],
        ["checks"], ["pay"], ["pays"], ["book"],
        ["books"], ["show"], ["send"]
    ],
    "P": [["with"], ["near"], ["for"], ["in"]],
    "Pronoun": [["I"], ["you"], ["we"], ["they"]]
}


# ------------------------------------------------
# 1. TOP-DOWN RECURSIVE DESCENT PARSER
# ------------------------------------------------
def top_down(symbol, words, pos, steps):
    steps[0] += 1
    # Terminal symbol
    if symbol not in grammar:
        if pos < len(words) and words[pos] == symbol:
            return {pos + 1}
        return set()
    results = set()
    for production in grammar[symbol]:
        positions = {pos}
        for item in production:
            new_positions = set()
            for current in positions:
                new_positions.update(
                    top_down(item, words, current, steps)
                )
            positions = new_positions
            if not positions:
                break
        results.update(positions)
    return results


# ------------------------------------------------
# 2. EARLEY PARSER
# ------------------------------------------------
def earley(words):
    n = len(words)
    chart = [set() for _ in range(n + 1)]
    # Initial state
    chart[0].add(("START", ("S",), 0, 0))
    for i in range(n + 1):
        changed = True
        while changed:
            changed = False
            for state in list(chart[i]):
                lhs, rhs, dot, origin = state
                # COMPLETER
                if dot == len(rhs):
                    for old in list(chart[origin]):
                        a, b, d, o = old
                        if d < len(b) and b[d] == lhs:
                            new_state = (a, b, d + 1, o)
                            if new_state not in chart[i]:
                                chart[i].add(new_state)
                                changed = True
                # PREDICTOR
                else:
                    next_symbol = rhs[dot]
                    if next_symbol in grammar:
                        for production in grammar[next_symbol]:
                            new_state = (
                                next_symbol,
                                tuple(production),
                                0,
                                i
                            )
                            if new_state not in chart[i]:
                                chart[i].add(new_state)
                                changed = True
        # SCANNER
        if i < n:
            for state in list(chart[i]):
                lhs, rhs, dot, origin = state
                if dot < len(rhs) and rhs[dot] == words[i]:
                    chart[i + 1].add(
                        (lhs, rhs, dot + 1, origin)
                    )
    accepted = (
        ("START", ("S",), 1, 0) in chart[n]
    )
    total_states = sum(len(column) for column in chart)
    return accepted, total_states


# ------------------------------------------------
# 3. SIMPLIFIED PCFG-STYLE LEXICAL SCORING
# ------------------------------------------------
def pcfg_score(sentence):
    words = sentence.split()
    score = 1.0
    determiner = ["the", "a"]
    nouns = [
        "student", "students", "teacher", "form",
        "fee", "room", "library", "exam", "hostel",
        "receipt", "notice"
    ]
    verbs = [
        "submit", "submits", "check", "checks",
        "pay", "pays", "book", "books", "show", "send"
    ]
    prepositions = ["with", "near", "for", "in"]
    pronouns = ["I", "you", "we", "they"]
    for word in words:
        if word in determiner:
            score *= 0.5
        elif word in nouns:
            score *= 0.
        elif word in verbs:
            score *= 0.1
        elif word in prepositions:
            score *= 0.2
        elif word in pronouns:
            score *= 0.5
        else:
            return 0.0
    return score

